# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ─── Build outputs ───────────────────────────────────────────────────────────
build/
dist/
out/
*.js.map

# CDK
infrastructure/cdk.out/
infrastructure/cdk-outputs.json

# ─── React Native (Expo CNG) ─────────────────────────────────────────────────
# android/ and ios/ are generated by `npx expo prebuild` from app.json — never commit them
app/.expo/
app/.metro-health-check*
app/amplifyconfiguration.json
app/android/
app/ios/

# Metro bundler
.metro-cache/

# ─── Environment & secrets ───────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key

# ─── Test & coverage ─────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ─── OS & editor ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/settings.json
.idea/

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── TypeScript ──────────────────────────────────────────────────────────────
*.tsbuildinfo

app/.kotlin/

# ─── Visual Studio & .NET (MAUI app in mobile/) ──────────────────────────────
# Per-session IDE state: .suo, .vsidx, .dtbcache.v2, ProjectEvaluation/*.bin
.vs/
# Per-developer debug target / emulator selection
*.user
# Note: scoped to mobile/ on purpose — a bare bin/ would swallow
# infrastructure/bin/app.ts, which is tracked CDK source.
mobile/bin/
mobile/obj/

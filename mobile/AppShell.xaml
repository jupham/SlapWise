<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SlapWise.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:auth="clr-namespace:SlapWise.Mobile.Views.Auth"
    xmlns:groups="clr-namespace:SlapWise.Mobile.Views.Groups"
    Shell.NavBarIsVisible="False">

    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate auth:LoginPage}"
        Route="LoginPage" />

    <ShellContent
        Title="My Groups"
        ContentTemplate="{DataTemplate groups:GroupListPage}"
        Route="GroupListPage" />

    <ShellContent
        Title="Group"
        ContentTemplate="{DataTemplate groups:GroupHomePage}"
        Route="GroupHomePage" />

</Shell>

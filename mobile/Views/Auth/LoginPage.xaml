<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SlapWise.Mobile.ViewModels"
             xmlns:inputs="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
             x:Class="SlapWise.Mobile.Views.Auth.LoginPage"
             x:DataType="vm:LoginViewModel">

    <Grid RowDefinitions="*,Auto,*">

        <VerticalStackLayout Grid.Row="0" VerticalOptions="End" HorizontalOptions="Center"
                             Spacing="6" Padding="0,0,0,48">
            <Label Text="💀" FontSize="64" HorizontalOptions="Center" />
            <Label Text="SlapWise" FontSize="34" FontAttributes="Bold" HorizontalOptions="Center" />
            <Label Text="Manchester Tracker" Style="{StaticResource Muted}" HorizontalOptions="Center" />
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="1" Padding="28,0" Spacing="4">

            <inputs:SfTextInputLayout Hint="Email" ContainerType="Outlined"
                                      OutlineCornerRadius="10"
                                      Stroke="{StaticResource Accent}"
                                      ContainerBackground="{StaticResource BgInput}">
                <Entry Text="{Binding Email}" Keyboard="Email" />
            </inputs:SfTextInputLayout>

            <inputs:SfTextInputLayout Hint="Password" ContainerType="Outlined"
                                      OutlineCornerRadius="10"
                                      Stroke="{StaticResource Accent}"
                                      ContainerBackground="{StaticResource BgInput}">
                <Entry Text="{Binding Password}" IsPassword="True" />
            </inputs:SfTextInputLayout>

            <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorLabel}" Margin="4,2"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource NotNullOrEmptyConverter}}" />

            <buttons:SfButton Text="Sign In" Command="{Binding LoginCommand}"
                              IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                              BackgroundColor="{StaticResource Accent}"
                              TextColor="White" CornerRadius="10"
                              HeightRequest="52" Margin="0,8,0,0" />

            <buttons:SfButton Text="Don't have an account? Register"
                              Command="{Binding GoToRegisterCommand}"
                              BackgroundColor="Transparent" TextColor="{StaticResource AccentText}"
                              HeightRequest="44" />
        </VerticalStackLayout>

        <BoxView Grid.Row="2" IsVisible="False" />

    </Grid>

</ContentPage>

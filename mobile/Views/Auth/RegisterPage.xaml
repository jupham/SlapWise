<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SlapWise.Mobile.ViewModels"
             xmlns:inputs="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
             x:Class="SlapWise.Mobile.Views.Auth.RegisterPage"
             x:DataType="vm:RegisterViewModel"
             Title="Create Account">

    <ScrollView>
        <VerticalStackLayout Padding="28,40" Spacing="4" VerticalOptions="Center">

            <Label Text="Create Account" FontSize="28" FontAttributes="Bold" Margin="0,0,0,20" />

            <!-- Registration -->
            <VerticalStackLayout Spacing="4"
                IsVisible="{Binding AwaitingConfirmation, Converter={StaticResource InvertedBoolConverter}}">

                <inputs:SfTextInputLayout Hint="Email" ContainerType="Outlined" OutlineCornerRadius="10"
                                          Stroke="{StaticResource Accent}"
                                          ContainerBackground="{StaticResource BgInput}">
                    <Entry Text="{Binding Email}" Keyboard="Email" />
                </inputs:SfTextInputLayout>

                <inputs:SfTextInputLayout Hint="Password" ContainerType="Outlined" OutlineCornerRadius="10"
                                          Stroke="{StaticResource Accent}"
                                          ContainerBackground="{StaticResource BgInput}">
                    <Entry Text="{Binding Password}" IsPassword="True" />
                </inputs:SfTextInputLayout>

                <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorLabel}" Margin="4,2"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource NotNullOrEmptyConverter}}" />

                <buttons:SfButton Text="Create Account" Command="{Binding RegisterCommand}"
                                  IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                                  BackgroundColor="{StaticResource Accent}" TextColor="White"
                                  CornerRadius="10" HeightRequest="52" Margin="0,8,0,0" />
            </VerticalStackLayout>

            <!-- Confirm email -->
            <VerticalStackLayout Spacing="12" IsVisible="{Binding AwaitingConfirmation}">
                <Label Text="✉️" FontSize="48" HorizontalOptions="Center" />
                <Label Text="Check your email" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center" />
                <Label Text="Enter the confirmation code we sent you."
                       Style="{StaticResource Muted}" HorizontalOptions="Center"
                       HorizontalTextAlignment="Center" Margin="0,0,0,12" />

                <inputs:SfTextInputLayout Hint="Confirmation code" ContainerType="Outlined"
                                          OutlineCornerRadius="10"
                                          Stroke="{StaticResource Accent}"
                                          ContainerBackground="{StaticResource BgInput}">
                    <Entry Text="{Binding ConfirmCode}" Keyboard="Numeric" />
                </inputs:SfTextInputLayout>

                <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorLabel}" Margin="4,2"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource NotNullOrEmptyConverter}}" />

                <buttons:SfButton Text="Confirm Email" Command="{Binding ConfirmCommand}"
                                  IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                                  BackgroundColor="{StaticResource Accent}" TextColor="White"
                                  CornerRadius="10" HeightRequest="52" Margin="0,8,0,0" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

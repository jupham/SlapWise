<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SlapWise.Mobile.ViewModels"
             xmlns:models="clr-namespace:SlapWise.Mobile.Models"
             xmlns:controls="clr-namespace:SlapWise.Mobile.Controls"
             xmlns:listview="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
             xmlns:popup="clr-namespace:Syncfusion.Maui.Popup;assembly=Syncfusion.Maui.Popup"
             xmlns:inputs="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
             xmlns:sfInputs="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
             x:Class="SlapWise.Mobile.Views.Groups.GrogPage"
             x:DataType="vm:GrogViewModel"
             Title="🍺 Grog">

    <ContentPage.Resources>
        <popup:PopupStyle x:Key="DarkPopup"
                          HeaderBackground="{StaticResource BgCard}"
                          HeaderTextColor="{StaticResource TextPrimary}"
                          MessageBackground="{StaticResource BgCard}"
                          OverlayColor="#99000000"
                          CornerRadius="16" />
    </ContentPage.Resources>

    <Grid x:Name="PageRoot">
        <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- Skull hero -->
            <Grid BackgroundColor="#111111" Padding="0,28,0,24">
                <VerticalStackLayout Spacing="16">

                    <controls:GrogSkullView
                        Entries="{Binding Grog.Entries}"
                        BottleSize="{Binding Grog.BottleSize}"
                        SloshTrigger="{Binding SloshTrigger}"
                        HorizontalOptions="Center"
                        WidthRequest="220" HeightRequest="272" />

                    <Label HorizontalOptions="Center" FontSize="13"
                           TextColor="{StaticResource TextSecondary}"
                           IsVisible="{Binding Grog, Converter={StaticResource NotNullToBoolConverter}}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding Grog.BottleSize, StringFormat='{0:F0} mL bottle'}" />
                                <Span Text=" · " />
                                <Span Text="{Binding Grog.Entries.Count, StringFormat='{0} liquors'}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <!-- Action buttons -->
                    <HorizontalStackLayout Spacing="10" HorizontalOptions="Center"
                                           IsVisible="{Binding Grog, Converter={StaticResource NotNullToBoolConverter}}">
                        <buttons:SfButton Text="+ Add Liquor"
                                          BackgroundColor="Transparent"
                                          TextColor="{StaticResource AccentText}"
                                          Stroke="{StaticResource BorderStrong}"
                                          StrokeThickness="1"
                                          CornerRadius="10" HeightRequest="46"
                                          Clicked="OnAddLiquorTapped" />
                        <buttons:SfButton Text="Take Shot"
                                          BackgroundColor="{StaticResource Accent}"
                                          TextColor="White" CornerRadius="10" HeightRequest="46"
                                          Command="{Binding TakeShotCommand}" />
                    </HorizontalStackLayout>

                    <!-- Not initialized -->
                    <VerticalStackLayout Spacing="12" Padding="32,0"
                                         IsVisible="{Binding Grog, Converter={StaticResource NullToBoolConverter}}">
                        <Label Text="The grog has not been initialized yet."
                               Style="{StaticResource Muted}" HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />
                        <buttons:SfButton Text="Initialize Grog"
                                          BackgroundColor="{StaticResource Accent}"
                                          TextColor="White" CornerRadius="10" HeightRequest="48"
                                          IsVisible="{Binding IsAdmin}"
                                          Command="{Binding InitializeCommand}"
                                          CommandParameter="750" />
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Grid>

            <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorLabel}"
                   Margin="16,12"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource NotNullOrEmptyConverter}}" />

            <!-- Contents -->
            <VerticalStackLayout IsVisible="{Binding Grog, Converter={StaticResource NotNullToBoolConverter}}">

                <Label Text="CONTENTS" Style="{StaticResource SectionHeader}" Margin="16,20,16,4" />

                <listview:SfListView ItemsSource="{Binding Grog.Entries}"
                                     SelectionMode="None" AutoFitMode="DynamicHeight"
                                     IsScrollingEnabled="False">
                    <listview:SfListView.EmptyView>
                        <Label Text="No liquors added yet." Style="{StaticResource Muted}" Margin="16,8" />
                    </listview:SfListView.EmptyView>
                    <listview:SfListView.ItemTemplate>
                        <DataTemplate x:DataType="models:GrogEntry">
                            <Border Style="{StaticResource Card}">
                                <Grid ColumnDefinitions="12,*,Auto" ColumnSpacing="12">
                                    <BoxView Grid.Column="0" WidthRequest="12" HeightRequest="12"
                                             CornerRadius="3" VerticalOptions="Center"
                                             BackgroundColor="{StaticResource Accent}" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="{Binding Brand}" FontAttributes="Bold" FontSize="15" />
                                        <Label Text="{Binding Category}" Style="{StaticResource Muted}" FontSize="12" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" FontSize="13" VerticalOptions="Center"
                                           TextColor="{StaticResource TextSecondary}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding AmountMl, StringFormat='{0:F0}'}" />
                                                <Span Text=" mL" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </listview:SfListView.ItemTemplate>
                </listview:SfListView>

                <!-- History -->
                <Label Text="HISTORY" Style="{StaticResource SectionHeader}" Margin="16,20,16,4" />

                <listview:SfListView ItemsSource="{Binding Grog.History}"
                                     SelectionMode="None" AutoFitMode="DynamicHeight"
                                     IsScrollingEnabled="False">
                    <listview:SfListView.EmptyView>
                        <Label Text="No history yet." Style="{StaticResource Muted}" Margin="16,8" />
                    </listview:SfListView.EmptyView>
                    <listview:SfListView.ItemTemplate>
                        <DataTemplate x:DataType="models:GrogHistoryEvent">
                            <Border Style="{StaticResource Card}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <VerticalStackLayout Grid.Column="0" Spacing="3">
                                        <Label Text="{Binding Type}" Style="{StaticResource AccentLabel}" />
                                        <Label Text="{Binding ActorPlayerId}" FontSize="13" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="{Binding OccurredAt}"
                                           FontSize="11" TextColor="{StaticResource TextMuted}"
                                           VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </listview:SfListView.ItemTemplate>
                </listview:SfListView>

                <BoxView HeightRequest="40" IsVisible="False" />

            </VerticalStackLayout>

        </VerticalStackLayout>
        </ScrollView>

        <!-- Add Liquor popup -->
        <popup:SfPopup x:Name="AddLiquorPopup"
                       HeaderTitle="Add Liquor"
                       ShowFooter="False"
                       ShowCloseButton="True"
                       PopupStyle="{StaticResource DarkPopup}"
                       WidthRequest="320">
            <popup:SfPopup.ContentTemplate>
                <DataTemplate>
                    <VerticalStackLayout Padding="20" Spacing="12">
                        <sfInputs:SfComboBox x:Name="CategoryPicker"
                                           Placeholder="Category"
                                           ItemsSource="{Binding Source={x:Reference PageRoot}, Path=BindingContext.CategoryNames}"
                                           TextColor="{StaticResource TextPrimary}"
                                           PlaceholderColor="{StaticResource TextMuted}" />
                        <sfInputs:SfComboBox x:Name="BrandPicker"
                                           Placeholder="Brand"
                                           ItemsSource="{Binding Source={x:Reference PageRoot}, Path=BindingContext.BrandsForCategory}"
                                           TextColor="{StaticResource TextPrimary}"
                                           PlaceholderColor="{StaticResource TextMuted}" />
                        <buttons:SfButton Text="Add"
                                          BackgroundColor="{StaticResource Accent}"
                                          TextColor="White" CornerRadius="10" HeightRequest="48"
                                          Clicked="OnAddLiquorConfirmed" />
                    </VerticalStackLayout>
                </DataTemplate>
            </popup:SfPopup.ContentTemplate>
        </popup:SfPopup>

    </Grid>

</ContentPage>

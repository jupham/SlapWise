<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SlapWise.Mobile.ViewModels"
             xmlns:models="clr-namespace:SlapWise.Mobile.Models"
             xmlns:listview="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
             xmlns:inputs="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
             x:Class="SlapWise.Mobile.Views.Groups.GroupListPage"
             x:DataType="vm:GroupListViewModel"
             Title="SlapWise">

    <ScrollView>
        <VerticalStackLayout Padding="16,28" Spacing="8">

            <Label Text="💀 SlapWise" FontSize="28" FontAttributes="Bold"
                   HorizontalOptions="Center" />
            <Label Text="Choose a group or create one" Style="{StaticResource Muted}"
                   HorizontalOptions="Center" Margin="0,0,0,16" />

            <!-- My groups -->
            <listview:SfListView ItemsSource="{Binding Groups}"
                                 SelectionMode="None"
                                 AutoFitMode="DynamicHeight"
                                 IsScrollingEnabled="False">
                <listview:SfListView.EmptyView>
                    <Label Text="No groups yet." Style="{StaticResource Muted}"
                           HorizontalOptions="Center" Margin="0,8" />
                </listview:SfListView.EmptyView>
                <listview:SfListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Group">
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding Name}" FontSize="17" FontAttributes="Bold" />
                                    <Label Text="{Binding InviteCode}" Style="{StaticResource Muted}" FontSize="12" />
                                </VerticalStackLayout>
                                <buttons:SfButton Grid.Column="1" Text="Enter"
                                                  BackgroundColor="{StaticResource Accent}"
                                                  TextColor="White" CornerRadius="8"
                                                  HeightRequest="40" WidthRequest="72"
                                                  CommandParameter="{Binding .}"
                                                  Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GroupListViewModel}}, Path=SelectGroupCommand}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </listview:SfListView.ItemTemplate>
            </listview:SfListView>

            <BoxView HeightRequest="1" Margin="16,12" />

            <!-- Join -->
            <Label Text="JOIN A GROUP" Style="{StaticResource SectionHeader}" Margin="4,0,0,4" />
            <inputs:SfTextInputLayout Hint="Invite code" ContainerType="Outlined" OutlineCornerRadius="10"
                                      Stroke="{StaticResource Accent}"
                                      ContainerBackground="{StaticResource BgInput}">
                <Entry Text="{Binding InviteCode}" />
            </inputs:SfTextInputLayout>
            <buttons:SfButton Text="Join Group" Command="{Binding JoinGroupCommand}"
                              BackgroundColor="{StaticResource Accent}" TextColor="White"
                              CornerRadius="10" HeightRequest="48" />

            <BoxView HeightRequest="1" Margin="16,12" />

            <!-- Create -->
            <Label Text="CREATE A GROUP" Style="{StaticResource SectionHeader}" Margin="4,0,0,4" />
            <inputs:SfTextInputLayout Hint="Group name" ContainerType="Outlined" OutlineCornerRadius="10"
                                      Stroke="{StaticResource Accent}"
                                      ContainerBackground="{StaticResource BgInput}">
                <Entry Text="{Binding NewGroupName}" />
            </inputs:SfTextInputLayout>
            <buttons:SfButton Text="Create Group" Command="{Binding CreateGroupCommand}"
                              BackgroundColor="{StaticResource AccentDim}" TextColor="White"
                              CornerRadius="10" HeightRequest="48" />

            <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorLabel}" Margin="4,4"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource NotNullOrEmptyConverter}}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

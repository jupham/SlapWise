<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Brand -->
    <Color x:Key="Accent">#7c3aed</Color>
    <Color x:Key="AccentDim">#5b21b6</Color>
    <Color x:Key="AccentText">#c4b5fd</Color>
    <Color x:Key="Danger">#ef4444</Color>

    <!-- Surfaces -->
    <Color x:Key="BgPage">#0d0d0d</Color>
    <Color x:Key="BgCard">#1a1a1a</Color>
    <Color x:Key="BgInput">#1e1e1e</Color>
    <Color x:Key="BgNav">#111111</Color>

    <!-- Borders -->
    <Color x:Key="BorderSubtle">#2a2a2a</Color>
    <Color x:Key="BorderStrong">#3a3a3a</Color>

    <!-- Text -->
    <Color x:Key="TextPrimary">#ffffff</Color>
    <Color x:Key="TextSecondary">#a1a1aa</Color>
    <Color x:Key="TextMuted">#52525b</Color>

    <!-- Legacy aliases so default styles don't crash -->
    <Color x:Key="Primary">#7c3aed</Color>
    <Color x:Key="PrimaryDark">#7c3aed</Color>
    <Color x:Key="PrimaryDarkText">#ffffff</Color>
    <Color x:Key="Secondary">#1a1a1a</Color>
    <Color x:Key="SecondaryDarkText">#a1a1aa</Color>
    <Color x:Key="Tertiary">#5b21b6</Color>
    <Color x:Key="White">#ffffff</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="Magenta">#7c3aed</Color>
    <Color x:Key="MidnightBlue">#0d0d0d</Color>
    <Color x:Key="OffBlack">#0d0d0d</Color>
    <Color x:Key="Gray100">#e4e4e7</Color>
    <Color x:Key="Gray200">#3f3f46</Color>
    <Color x:Key="Gray300">#52525b</Color>
    <Color x:Key="Gray400">#71717a</Color>
    <Color x:Key="Gray500">#71717a</Color>
    <Color x:Key="Gray600">#27272a</Color>
    <Color x:Key="Gray900">#18181b</Color>
    <Color x:Key="Gray950">#0d0d0d</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />
    <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource BgCard}" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtle}" />

</ResourceDictionary>

{
  "expo": {
    "name": "SlapWise",
    "slug": "slapwise",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0C0E",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.slapwise",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "icon": "./assets/slapwise.icon"
    },
    "android": {
      "package": "com.slapwise",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0C0E"
      }
    },
    "extra": {
      "eas": {
        "projectId": "56e39eae-e67b-430a-95a1-037e28e81251"
      }
    },
    "owner": "nupham",
    "plugins": [
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#F56600"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0B0C0E"
        }
      ]
    ]
  }
}

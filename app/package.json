    "@tsconfig/react-native": "^3.0.9",
    "@types/react": "^19.2.14",
    "@vitest/coverage-v8": "^4.1.0",
    "fast-check": "^4.6.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.0"
  }

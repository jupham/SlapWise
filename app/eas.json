{
  "cli": {
    "version": ">= 20.5.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_STAGE": "dev"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_STAGE": "dev"
      }
    },
    "simulator": {
      "node": "24.14.0",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_STAGE": "dev"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_STAGE": "prod"
      }
    }
  },
  "submit": {
    "production": {}
  }
}

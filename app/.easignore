# When this file exists, EAS Build uses it INSTEAD of .gitignore to decide what
# gets uploaded. It therefore has to repeat everything .gitignore excludes, or
# those files start being shipped to the build servers.
#
# The reason it exists: amplifyconfiguration.json is generated by
# `infrastructure/scripts/generate-amplify-config.js` and is gitignored, so an
# EAS build would upload the project without it. The build compiles fine and
# the app then launches with no Amplify config — configureAmplify() no-ops and
# the first authFetch fails on a missing require. Nothing in the EAS output
# warns about it, so the failure only shows up on the device.
#
# The file holds a Cognito user pool id, client id and endpoints. None of that
# is secret; it is embedded in every distributed binary regardless. Keeping it
# out of git but inside the build is the behaviour we want.

# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Native projects (regenerated by prebuild on the build server) ────────────
android/
ios/
.expo/
.metro-health-check*
.kotlin/

# ── Build outputs ────────────────────────────────────────────────────────────
build/
dist/
out/
*.js.map
.metro-cache/

# ── Environment & secrets ────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key

# ── Tests, logs, editor state ────────────────────────────────────────────────
coverage/
.nyc_output/
*.log
npm-debug.log*
.DS_Store
Thumbs.db
.vscode/settings.json
.idea/
.vs/
*.user
*.tsbuildinfo

# Deliberately NOT ignored: amplifyconfiguration.json

{
  "name": "slapwise-infra",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "cdk": "cdk",
    "seed": "node scripts/seed-dev-data.js",
    "deploy": "tsc && cdk deploy --all --profile slapwise --outputs-file cdk-outputs.json && node scripts/generate-amplify-config.js",
    "synth": "cdk synth --profile slapwise"
  },
  "devDependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1095.0",
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "24.x",
    "aws-cdk": "^2.200.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.4.0"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.0.0",
    "@aws-sdk/client-sns": "^3.1024.0",
    "aws-cdk-lib": "^2.200.0",
    "constructs": "^10.0.0",
    "source-map-support": "^0.5.21"
  }
}
